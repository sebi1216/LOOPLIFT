# Install only package versions that are at least 7 days old (protects against fresh malware
# releases). Works only with npm 11.10 or newer (`npm -v`); older npm ignores it silently.
# /kickoff checks your npm version. CLAUDE.md rule 3 (publish date at least 7 days ago) is the stand-in.
# Optional upgrade: npm install -g npm@11 (never npm@latest: npm 12 needs a newer Node). See docs/how-this-repo-works.md.
min-release-age=7
